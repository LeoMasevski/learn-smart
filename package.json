{
  "name": "learnsmart",
  "private": true,
  "version": "0.1.0",
  "description": "LearnSmart — personalizirano učenje z AI",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:json": "cd json-server && npx json-server db.json --port 3001 --watch",
    "dev": "node scripts/dev.js",
    "build": "npm run build --prefix backend && npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
